{
  "info": {
    "name": "Adopet - Pruebas de la API",
    "description": "Pruebas funcionales de la API de Adopet contra el sistema de prueba (base zoonosis_test).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Iniciar sesión como administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/auth/login",
          "host": [
            "{{base}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@zoonosis.test\",\n  \"password\": \"Zoo12345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve el token y el rol ADMIN', () => { const b = pm.response.json(); pm.expect(b.user.role).to.eql('ADMIN'); pm.collectionVariables.set('adminToken', b.accessToken); });"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('stamp', Date.now().toString().slice(-7));",
              "pm.collectionVariables.set('hoy', new Date().toISOString());",
              "pm.collectionVariables.set('manana', new Date(Date.now() + 86400000).toISOString());"
            ]
          }
        }
      ]
    },
