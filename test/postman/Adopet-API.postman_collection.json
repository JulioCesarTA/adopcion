        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman {{stamp}}\",\n  \"species\": \"PERRO\",\n  \"sex\": \"MACHO\",\n  \"size\": \"MEDIANO\",\n  \"energyLevel\": 3,\n  \"goodWithChildren\": true,\n  \"goodWithAnimals\": true,\n  \"needsYard\": false,\n  \"specialCare\": false,\n  \"requiredDailyHours\": 2,\n  \"entryDate\": \"{{hoy}}\",\n  \"entryReason\": \"Prueba con Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', () => pm.response.to.have.status(201));",
              "pm.test('Código ZOO-AAAA-NNNN y estado Ingresado', () => { const b = pm.response.json(); pm.expect(b.code).to.match(/^ZOO-\\d{4}-\\d{4}$/); pm.expect(b.status).to.eql('INGRESADO'); pm.collectionVariables.set('animalId', b.id); });"
            ]
          }
        }
      ]
