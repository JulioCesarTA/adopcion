# ===========================================================================
# Variables del despliegue en EC2. Copiar a `.env` EN LA INSTANCIA y completar.
#
#   cp .env.production.example .env && nano .env
#
# Este archivo NO debe subirse al repositorio con valores reales (.env está en
# .gitignore). Los secretos del CI/CD van en GitHub → Settings → Secrets.
# ===========================================================================

# ------------------------------------------------------------------- Dominio
# Dominio que apunta (registro A) a la IP pública elástica de la EC2.
DOMAIN=zoonosis.ejemplo.com
# Correo para los avisos de vencimiento de Let's Encrypt.
CERTBOT_EMAIL=admin@ejemplo.com
# Poner en "true" para probar sin gastar el límite de Let's Encrypt
# (5 certificados por dominio por semana). El cert NO será de confianza.
CERTBOT_STAGING=false
# Poner en "true" solo si existe el registro DNS de www.DOMINIO.
CERTBOT_INCLUDE_WWW=false

# -------------------------------------------------------------- Base de datos
# Contenedor PostgreSQL de docker-compose.prod.yml.
POSTGRES_USER=zoonosis
POSTGRES_PASSWORD=CAMBIA-ESTA-CONTRASENA-LARGA
POSTGRES_DB=zoonosis
DATABASE_URL="postgresql://zoonosis:CAMBIA-ESTA-CONTRASENA-LARGA@db:5432/zoonosis?schema=public"
#
# Para usar Amazon RDS en lugar del contenedor:
#   1. Comenta el servicio `db` en docker-compose.prod.yml.
#   2. Apunta DATABASE_URL al endpoint de RDS y exige TLS:
# DATABASE_URL="postgresql://usuario:clave@mi-db.xxxx.us-east-1.rds.amazonaws.com:5432/zoonosis?schema=public&sslmode=require"

# ------------------------------------------------------------------- Seguridad
# Generar cada uno con:  openssl rand -base64 48
JWT_ACCESS_SECRET=GENERAR-CON-openssl-rand-base64-48
JWT_REFRESH_SECRET=GENERAR-OTRO-DISTINTO-base64-48
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# ------------------------------------------------------- Fotos de animales (S3)
# `s3` en producción; `local` guarda en el volumen de Docker.
STORAGE_DRIVER=s3
S3_BUCKET=zoonosis-scz-fotos
AWS_REGION=us-east-1
# Opcional: dominio de CloudFront o del bucket. Si se deja vacío se usa
# https://<S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com
S3_PUBLIC_BASE_URL=
#
# RECOMENDADO: dejar estas dos vacías y darle a la EC2 un rol IAM con permiso
# s3:PutObject y s3:DeleteObject sobre el bucket. El SDK toma las credenciales
# del rol automáticamente y no hay claves guardadas en el servidor.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------------------------- Correo
# Producción: Resend (smtp.resend.com, puerto 465, SMTP_SECURE=true,
# SMTP_USER=resend, SMTP_PASS=la API key) o Brevo (smtp-relay.brevo.com:587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zoonosis SCZ <no-reply@zoonosis.ejemplo.com>"
CONTACT_TO=contacto@zoonosis.ejemplo.com

# ------------------------------------------------------- Asistente virtual (IA)
# console.anthropic.com → API Keys. Sin clave el bot responde "no disponible".
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5

# ------------------------------------------- Datos públicos de la institución
INSTITUTION_NAME="Asociación de Zoonosis de Santa Cruz de la Sierra"
INSTITUTION_SHORT_NAME="Zoonosis SCZ"
INSTITUTION_ADDRESS="Santa Cruz de la Sierra, Bolivia"
INSTITUTION_PHONE="+591 3 000 0000"
INSTITUTION_EMAIL=contacto@zoonosis.ejemplo.com
INSTITUTION_HOURS="Lunes a viernes de 8:00 a 16:00; sábados de 8:00 a 12:00"
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
SOCIAL_WHATSAPP=

# ------------------------------------------------------------------- Imágenes
# Las rellena el CI/CD al desplegar. En local se construye con `--build`.
BACKEND_IMAGE=ghcr.io/USUARIO/REPO-backend:latest
FRONTEND_IMAGE=ghcr.io/USUARIO/REPO-frontend:latest

# --------------------------------------------------------------------- Primer
# Poner en "true" SOLO en el primer despliegue para crear los usuarios
# iniciales (admin@zoonosis.test / Zoo12345) y el catálogo de vacunas.
# Volver a "false" inmediatamente después y cambiar esas contraseñas.
RUN_SEED=false
