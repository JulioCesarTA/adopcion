# Conexión a PostgreSQL (docker compose up levanta esta BD)
DATABASE_URL="postgresql://zoonosis:zoonosis@localhost:5432/zoonosis?schema=public"

# Puerto del API
PORT=4000

# Origen permitido para CORS (URL del frontend)
FRONTEND_URL="http://localhost:3000"

# JWT: usa valores largos y aleatorios en producción
JWT_ACCESS_SECRET="cambia-esto-access-secret-de-desarrollo"
JWT_REFRESH_SECRET="cambia-esto-refresh-secret-de-desarrollo"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Cookie del refresh token. En producción: COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Carpeta donde se guardan las fotos de los animales
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# Correo del formulario «Contáctame» (SMTP genérico)
# Desarrollo: Mailtrap Sandbox (atrapa los correos, no llegan a nadie real)
#   mailtrap.io → Email Testing → Inboxes → SMTP Settings
# Producción: Resend (smtp.resend.com, puerto 465, user "resend", pass = API key),
#   Brevo (smtp-relay.brevo.com:587) o Mailtrap Email Sending.
# Si SMTP_HOST está vacío, los mensajes solo se guardan en la BD.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zoonosis SCZ <no-reply@zoonosis.test>"
# Buzón de la institución que recibe los mensajes
CONTACT_TO=contacto@zoonosis.test

# ---------------------------------------------------------------------------
# Asistente virtual (Claude). Sin API key el bot responde "no disponible".
# Obtén la clave en console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo (por defecto Claude Opus 5.5). Alternativa más económica: claude-haiku-5-5
CHAT_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Datos públicos de la institución (landing, bot y correos). REEMPLAZAR por los reales.
INSTITUTION_NAME="Asociación de Zoonosis de Santa Cruz de la Sierra"
INSTITUTION_SHORT_NAME="Zoonosis SCZ"
INSTITUTION_ADDRESS="Santa Cruz de la Sierra, Bolivia"
INSTITUTION_PHONE="+591 3 000 0000"
INSTITUTION_EMAIL=contacto@zoonosis.test
INSTITUTION_HOURS="Lunes a viernes de 8:00 a 16:00; sábados de 8:00 a 12:00"
# Redes sociales (vacío = no se muestra)
SOCIAL_FACEBOOK=https://www.facebook.com/
SOCIAL_INSTAGRAM=https://www.instagram.com/
SOCIAL_TIKTOK=https://www.tiktok.com/
SOCIAL_YOUTUBE=
SOCIAL_WHATSAPP=https://wa.me/59170000000
